# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Any long random string. Used to sign login tokens — changing it logs
# everyone out. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The URL the frontend is served from. Since server/index.js serves the
# frontend itself, this can stay as the default unless you're running the
# frontend somewhere else (like VS Code's Live Server).
CLIENT_ORIGIN=http://localhost:5000

# Port the server listens on.
PORT=5000

# How often (in hours) each zone's photo challenge rotates to the next
# prompt in its list. 72 = every 3 days, the real setting. While testing
# locally, set this much lower (e.g. 0.02, about a minute) so you can
# actually see a rotation happen without waiting a full day.
CHALLENGE_ROTATION_HOURS=72

# Geofence: "on" (default) only accepts a photo if the player's phone says
# they're inside the zone's turf. Set to "off" to submit from anywhere while
# testing at home.
GEOFENCE=on

# Where the database and uploaded photos live. Leave these out locally (they
# default to server/db/vantage.db and server/uploads). On Railway, set them
# to paths on the persistent volume so data survives redeploys:
#   DB_PATH=/data/vantage.db
#   UPLOAD_DIR=/data/uploads
