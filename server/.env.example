# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Any long random string. Used to sign login tokens — changing it logs
# everyone out. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The URL the frontend is served from. Since server/index.js serves the
# frontend itself, this can stay as the default unless you're running the
# frontend somewhere else (like VS Code's Live Server).
CLIENT_ORIGIN=http://localhost:5000

# Port the server listens on.
PORT=5000
